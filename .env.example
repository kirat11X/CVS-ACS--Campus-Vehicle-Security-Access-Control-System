# PostgreSQL Configuration
POSTGRES_DB=campus_security
POSTGRES_USER=campus_admin
POSTGRES_PASSWORD=campus_dev_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# SQLAlchemy Database URL
DATABASE_URL=postgresql+psycopg://campus_admin:campus_dev_pass@localhost:5433/campus_security

# MQTT Broker Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=frigate

# Frigate Configuration
FRIGATE_HOST=localhost
FRIGATE_PORT=5000
FRIGATE_RTSP_PORT=8554

# n8n Configuration
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/test-invoice

# WhatsApp Provider Configuration (Phase 7)
#   local = no WhatsApp Business API yet: riders open http://<server LAN IP>:8000/intake on a phone;
#           replies are shown there and stored in media/whatsapp_outbox/outbox.jsonl (default)
#   mock  = in-memory test double
#   meta  = WhatsApp Cloud API stub; reports unavailable until WHATSAPP_TOKEN and WHATSAPP_PHONE_ID are real
WHATSAPP_PROVIDER=local
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Older names, still read when the two above are empty
WHATSAPP_API_TOKEN=mock_token_for_local_dev
WHATSAPP_PHONE_NUMBER_ID=mock_phone_id
# Meta webhook handshake token and app secret (signatures are verified when the secret is set)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# Delivery screening (Phase 7)
# MEDIA_ROOT=media        (default <repo>/media; relative paths are resolved against the repo root)
INVOICE_MAX_UPLOAD_MB=10
SCREENING_LINE_MIN_CONFIDENCE=0.60
# Address printed for riders; default http://<LAN address>:<port>/intake
INTAKE_PUBLIC_URL=
ALERTS_LOOKBACK_HOURS=24
REGISTRY_MATCH_MAX_EDITS=1

# Authentication (Phase 5C) - generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=change-me
AUTH_TOKEN_TTL_MINUTES=720

# Registry linkage & live feed (Phase 5C)
RESOLUTION_CONFIDENCE_THRESHOLD=0.80
RESOLUTION_SUGGESTION_MIN_SIMILARITY=0.70
RESOLUTION_SUGGESTION_LIMIT=5
FEED_STREAM_POLL_SECONDS=1.0
FEED_REGISTRY_LOOKBACK_HOURS=24
GUARD_REGISTRATION_MAX_VALIDITY_HOURS=168

# Movement logging & presence (Phase 6) - unverified starting values
MOVEMENT_DEBOUNCE_SECONDS=60
PRESENCE_LONG_STAY_HOURS=24
PRESENCE_UNATTRIBUTED_LOOKBACK_HOURS=24

# Web & mobile console (Phase 16). Browser origins allowed to call the API directly.
# The web console uses the /api proxy and needs none; the Capacitor app runs on these origins.
CORS_ALLOW_ORIGINS=capacitor://localhost,https://localhost,http://localhost

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
