[Unit]
Description=CVS-ACS Full-Stack Docker Compose Orchestration
Documentation=https://github.com/kirat11X/CVS-ACS--Campus-Vehicle-Security-Access-Control-System
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/kirat/coding/honours
User=kirat
Group=kirat

# Compose lifecycle commands
ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f docker-compose.prod.yml down
ExecReload=/usr/bin/docker compose -f docker-compose.prod.yml up -d --no-deps --build

# Resource management & recovery
TimeoutStartSec=300
TimeoutStopSec=60
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
